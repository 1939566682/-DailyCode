pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: nav-bg
    elementType: shape
    bounds: [0, 0, 1280, 36]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
  - elementId: nav-active
    elementType: shape
    bounds: [960, 32, 320, 4]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"
  - elementId: nav-text1
    elementType: text
    bounds: [0, 0, 320, 32]
    content:
      style: "$nav"
      color: "$lightText"
      align: [center, middle]
      wrap: false
      text: |
        <p>项目背景与定位</p>
  - elementId: nav-text2
    elementType: text
    bounds: [320, 0, 320, 32]
    content:
      style: "$nav"
      color: "$lightText"
