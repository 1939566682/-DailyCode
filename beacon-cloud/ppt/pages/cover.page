pageType: cover
background:
  type: solid
  color: "$darkBg"
elements:
  - elementId: cover-accent-line
    elementType: shape
    bounds: [540, 310, 200, 4]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"
  - elementId: cover-title
    elementType: text
    bounds: [140, 240, 1000, 60]
    content:
      style: "$title"
      fontSize: 40
      color: "$light"
      align: [center, middle]
      wrap: false
      text: |
        <p><strong>beacon-cloud</strong> 分布式短信平台</p>
  - elementId: cover-subtitle
    elementType: text
    bounds: [240, 330, 800, 40]
    content:
      fontSize: 20
      color: "$lightText"
      fontFamily: "QuattrocentoSans, MiSans"
      align: [center, middle]
      wrap: false
      text: |
        <p>基于 Spring Cloud 微服务架构的 SMS Gateway 项目汇报</p>
  - elementId: cover-info
    elementType: text
    bounds: [340, 600, 600, 30]
    content:
      fontSize: 14
      color: "$secondary"
      fontFamily: "QuattrocentoSans, MiSans"
      align: [center, middle]
      wrap: false
      text: |
        <p>beacon-cloud 项目 | 2026</p>