pageType: final
background:
  type: solid
  color: "$darkBg"
elements:
  - elementId: final-accent-line
    elementType: shape
    bounds: [540, 310, 200, 4]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"
  - elementId: final-title
    elementType: text
    bounds: [140, 240, 1000, 60]
    content:
      fontSize: 40
      color: "$light"
      fontFamily: "QuattrocentoSans, alimamashuheiti"
      align: [center, middle]
      wrap: false
      text: |
        <p><strong>谢谢聆听</strong></p>
  - elementId: final-subtitle
    elementType: text
    bounds: [240, 330, 800, 40]
    content:
      fontSize: 20
      color: "$lightText"
      fontFamily: "QuattrocentoSans, MiSans"
      align: [center, middle]
      wrap: false
      text: |
        <p>beacon-cloud — 基于 Spring Cloud 的分布式短信平台</p>
  - elementId: final-info
    elementType: text
    bounds: [340, 420, 600, 30]
    content:
      fontSize: 16
      color: "$secondary"
      fontFamily: "QuattrocentoSans, MiSans"
      align: [center, middle]
      wrap: false
      text: |
        <p>欢迎提问与交流</p>
  - elementId: final-project
    elementType: text
    bounds: [340, 600, 600, 30]
    content:
      fontSize: 14
      color: "$secondary"
      fontFamily: "QuattrocentoSans, MiSans"
      align: [center, middle]
      wrap: false
      text: |
        <p>beacon-cloud 项目 | 2026</p>
