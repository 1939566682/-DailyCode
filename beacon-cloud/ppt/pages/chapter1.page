pageType: chapter
background:
  type: solid
  color: "$darkBg"
elements:
  - elementId: ch1-hero-num
    elementType: text
    bounds: [60, 160, 300, 120]
    content:
      style: "$heroNumber"
      color: "#FFFFFF18"
      fontSize: 120
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>01</strong></p>
  - elementId: ch1-accent-line
    elementType: shape
    bounds: [60, 310, 60, 4]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"
  - elementId: ch1-title
    elementType: text
    bounds: [60, 330, 600, 50]
    content:
      fontSize: 36
      color: "$light"
      fontFamily: "QuattrocentoSans, alimamashuheiti"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>项目背景与定位</strong></p>
  - elementId: ch1-subtitle
    elementType: text
    bounds: [60, 390, 600, 30]
    content:
      fontSize: 18
      color: "$lightText"
      fontFamily: "QuattrocentoSans, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p>了解 beacon-cloud 是什么、解决什么问题、使用什么技术</p>
