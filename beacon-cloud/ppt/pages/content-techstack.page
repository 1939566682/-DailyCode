    fill:
      type: solid
      color: "$accent"
  - elementId: nav-text1
    elementType: text
    bounds: [0, 0, 320, 32]
    content:
      style: "$nav"
      color: "$accent"
      align: [center, middle]
      wrap: false
      text: |
        <p>项目背景与定位</p>
  - elementId: nav-text2
    elementType: text
    bounds: [320, 0, 320, 32]
    content:
      style: "$nav"
      color: "$lightText"
