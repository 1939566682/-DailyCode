pageType: chapter
background:
  type: solid
  color: "$darkBg"
elements:
  - elementId: ch2-hero-num
    elementType: text
    bounds: [60, 160, 300, 120]
    content:
      style: "$heroNumber"
      color: "#FFFFFF18"
      fontSize: 120
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>02</strong></p>
  - elementId: ch2-accent-line
    elementType: shape
    bounds: [60, 310, 60, 4]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"
  - elementId: ch2-title
    elementType: text
    bounds: [60, 330, 600, 50]
    content:
      fontSize: 36
      color: "$light"
      fontFamily: "QuattrocentoSans, alimamashuheiti"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>系统架构设计</strong></p>
  - elementId: ch2-subtitle
    elementType: text
    bounds: [60, 390, 600, 30]
    content:
      fontSize: 18
      color: "$lightText"
      fontFamily: "QuattrocentoSans, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p>微服务拆分、模块职责、核心业务流程</p>
