<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.mapper.SmsRoleMenuMapper">
    <!-- TODO: 需确认 sms_role_menu 表是否已创建 -->

    <!-- 根据角色ID查询菜单ID列表 -->
    <select id="findMenuIdsByRoleId" resultType="java.lang.Long">
        SELECT menu_id FROM sms_role_menu
        WHERE role_id = #{roleId}
    </select>

    <!-- 删除角色的所有菜单关联 -->
    <delete id="deleteByRoleId">
        DELETE FROM sms_role_menu
        WHERE role_id = #{roleId}
    </delete>

    <!-- 批量插入角色菜单关联 -->
    <insert id="insertBatch">
        INSERT INTO sms_role_menu (role_id, menu_id)
        VALUES
        <foreach collection="menuIds" item="menuId" separator=",">
            (#{roleId}, #{menuId})
        </foreach>
    </insert>
</mapper>
