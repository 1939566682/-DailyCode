pageType: chapter
background:
  type: solid
  color: "$darkBg"
elements:
  - elementId: ch3-hero-num
    elementType: text
    bounds: [60, 160, 300, 120]
    content:
      style: "$heroNumber"
      color: "#FFFFFF18"
      fontSize: 120
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>03</strong></p>
  - elementId: ch3-accent-line
    elementType: shape
    bounds: [60, 310, 60, 4]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"
  - elementId: ch3-title
    elementType: text
    bounds: [60, 330, 600, 50]
    content:
      fontSize: 36
      color: "$light"
      fontFamily: "QuattrocentoSans, alimamashuheiti"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>关键技术亮点</strong></p>
  - elementId: ch3-subtitle
    elementType: text
    bounds: [60, 390, 600, 30]
    content:
      fontSize: 18
      color: "$lightText"
      fontFamily: "QuattrocentoSans, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p>设计模式、协议实现、动态配置、数据管理</p>
